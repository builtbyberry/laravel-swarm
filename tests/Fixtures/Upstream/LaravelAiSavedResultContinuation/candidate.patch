+<?php
+
+namespace Laravel\Ai\Storage;
+
+use Closure;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+use Laravel\Ai\Continuations\Continuation;
+use Laravel\Ai\Contracts\RemembersConversations;
+use Laravel\Ai\Exceptions\ApprovalMismatchException;
+use Laravel\Ai\Exceptions\ContinuationConflictException;
+use Laravel\Ai\Middleware\RememberConversation;
+use Laravel\Ai\Models\Conversation;
+use Laravel\Ai\Prompts\AgentPrompt;
+use Laravel\Ai\Responses\AgentResponse;
+use Laravel\Ai\Responses\StructuredAgentResponse;
+
+/**
+ * Uses the stored assistant row as a versioned turn record. Remote provider and
+ * tool I/O always runs outside the short compare-and-swap transactions here.
+ */
+trait ManagesContinuations
+{
+    public function claimTurn(AgentPrompt $prompt): ?array
+    {
+        $agent = $prompt->agent;
+
+        if (! $agent instanceof RemembersConversations && ! RememberConversation::appliesTo($agent)) {
+            throw new ContinuationConflictException('Agent must implement the conversation contract.');
+        }
+
+        $conversationId = $this->currentConversationFor($agent);
+        $target = $prompt->continuation;
+
+        if ($target !== null && $target->conversationId !== $conversationId) {
+            throw new ContinuationConflictException('Continuation conversation does not match the agent.');
+        }
+
+        if ($conversationId === null) {
+            return null;
+        }
+
+        return DB::connection($this->connection)->transaction(function () use ($prompt, $agent, $conversationId, $target): ?array {
+            $rows = $this->assistantRows($conversationId)->lockForUpdate()->get();
+            $row = $target === null
+                ? $rows->first(fn (object $candidate): bool => isset($this->decoded($candidate->meta)['continuation']))
+                : $rows->firstWhere('id', $target->turnId);
+
+            if ($row === null) {
+                if ($target !== null) {
+                    throw new ContinuationConflictException('The requested continuation turn does not exist.');
+                }
+
+                return null;
+            }
+
+            $meta = $this->decoded($row->meta);
+            $native = $meta['continuation'] ?? null;
+
+            if (($native['version'] ?? null) !== 1) {
+                if ($target !== null) {
+                    throw new ContinuationConflictException('This legacy turn has no continuation state; drain or reconcile it explicitly.');
+                }
+
+                return null;
+            }
+
+            // Keep Laravel AI's existing approval-resume behavior compatible: ordinary
+            // Decisions may be supplied without the participant that opened the
+            // conversation. Explicit durable Continuations, however, are bearer-like
+            // replay requests and must always prove conversation ownership.
+            if ($target !== null) {
+                $this->assertContinuationOwner($conversationId, $this->conversationParticipantFor($agent));
+            }
+
+            if (($native['status'] ?? null) === 'running') {
+                throw new ContinuationConflictException('The conversation has an active native owner.');
+            }
+
+            $ordinary = ! $prompt->hasApprovalDecisions() && $target === null;
+            $pending = $this->pausedCallIds($row);
+
+            if (! $ordinary && $target === null && $pending !== [] && ($native['status'] ?? null) !== 'awaiting') {
+                throw new ContinuationConflictException('An interrupted approval requires effect reconciliation; decisions cannot be replayed.');
+            }
+
+            $head = $this->table($this->messagesTable())->where('conversation_id', $conversationId)->max('id');
+
+            if (! $ordinary) {
+                if ($target !== null && ($row->agent !== $agent::class
+                    || ($native['agent'] ?? null) !== $agent::class
+                    || ($native['provider'] ?? null) !== $prompt->provider()->name()
+                    || ($native['provider_class'] ?? null) !== $prompt->provider()::class
+                    || ($native['model'] ?? null) !== $prompt->model)) {
+                    throw new ContinuationConflictException('Agent, provider or model does not match the saved turn.');
+                }
+
+                if ($this->table($this->messagesTable())->where('conversation_id', $conversationId)->where('id', '>', $row->id)->exists()) {
+                    if ($target !== null) {
+                        throw new ContinuationConflictException('A newer conversation turn exists.');
+                    }
+
+                    return null;
+                }
+            }
+
+            if ($target !== null) {
+                if ($target->revision !== ($native['revision'] ?? null)
+                    || ($native['status'] ?? null) !== 'ready'
+                    || $pending !== []) {
+                    throw new ContinuationConflictException('The turn is not ready at the requested revision.');
+                }
+
+                if (! $this->hasReplayBlocks($row)) {
+                    throw new ContinuationConflictException('Required per-step provider replay data is missing.');
+                }
+            } elseif (! $ordinary && ($pending === [] || ($native['status'] ?? null) !== 'awaiting')) {
+                return null;
+            }
+
+            $stop = false;
+
+            if ($prompt->hasApprovalDecisions()) {
+                $decisions = $prompt->approvalDecisions->all();
+
+                if (array_diff(array_keys($decisions), ['*'], $pending) !== []
+                    || (! array_key_exists('*', $decisions) && array_diff($pending, array_keys($decisions)) !== [])) {
+                    throw new ApprovalMismatchException(
+                        'Approval decisions do not match the pending tool calls.',
+                        $this->pendingApprovalsIn($row),
+                    );
+                }
+
+                foreach ($pending as $id) {
+                    $decision = $decisions[$id] ?? $decisions['*'] ?? null;
+                    $stop = $stop || $decision === null || ($decision->isRejected() && $decision->result === null);
+                }
+            }
+
+            $claim = [
+                'conversation' => $conversationId,
+                'turn' => $row->id,
+                'owner' => (string) Str::uuid7(),
+                'request_revision' => $native['revision'],
+                'ordinary' => $ordinary,
+                'stop' => $stop,
+                'prior_status' => $native['status'],
+                'offset' => $target !== null ? ($native['generation_attempts'] ?? 0) : 0,
+            ];
+
+            $meta['continuation'] = array_replace($native, [
+                'status' => 'running',
+                'owner' => $claim['owner'],
+                'revision' => $native['revision'] + 1,
+                'requested_stop' => $ordinary ? ($native['requested_stop'] ?? false) : $stop,
+                'ordinary' => $ordinary,
+                'prior_status' => $native['status'],
+                'head_at_claim' => $head,
+            ]);
+
+            $this->compareAndSwapTurn($row, $meta);
+
+            return $claim;
+        });
+    }
+
+    public function finishTurn(array $claim, AgentResponse $response, Closure $persist): void
+    {
+        DB::connection($this->connection)->transaction(function () use ($claim, $response, $persist): void {
+            $this->ownedTurn($claim);
+            $persist();
+
+            [$row, $meta] = $this->ownedTurn($claim);
+            $native = $meta['continuation'];
+            $native['status'] = $claim['ordinary']
+                ? (in_array($claim['prior_status'], ['completed', 'stopped'], true) ? $claim['prior_status'] : 'superseded')
+                : ($response->hasPendingApprovals() ? 'awaiting' : ($claim['stop'] ? 'stopped' : 'completed'));
+            $native['revision']++;
+
+            if ($native['status'] === 'awaiting') {
+                $native['owner'] = null;
+                $native['requested_stop'] = false;
+                $native['prior_status'] = 'awaiting';
+            }
+
+            if ($native['status'] === 'completed' && ! $claim['ordinary']) {
+                $native['receipt_revision'] = $claim['request_revision'];
+                $native['receipt'] = json_decode(json_encode([
+                    'invocation_id' => $response->invocationId,
+                    'text' => $response->text,
+                    'structured' => $response instanceof StructuredAgentResponse ? $response->toArray() : null,
+                    'usage' => $response->usage,
+                    'meta' => $response->meta,
+                    'reasoning' => $response->reasoning,
+                    'tool_calls' => $response->toolCalls,
+                    'tool_results' => $response->toolResults,
+                    'steps' => $response->steps,
+                    'conversation_id' => $response->conversationId,
+                    'assistant_message_id' => $response->assistantMessageId,
+                ], JSON_THROW_ON_ERROR), true, flags: JSON_THROW_ON_ERROR);
+            }
+
+            $meta['continuation'] = $native;
+            $this->compareAndSwapTurn($row, $meta);
+        });
+    }
+
+    public function interruptTurn(array $claim): void
+    {
+        DB::connection($this->connection)->transaction(function () use ($claim): void {
+            $row = $this->table($this->messagesTable())->where('id', $claim['turn'])->first();
+
+            if ($row === null) {
+                return;
+            }
+
+            $meta = $this->decoded($row->meta);
+            $native = $meta['continuation'] ?? [];
+
+            if (($native['owner'] ?? null) !== $claim['owner'] || ($native['status'] ?? null) !== 'running') {
+                return;
+            }
+
+            $native['status'] = $claim['ordinary'] ? $claim['prior_status'] : 'interrupted';
+            $native['revision']++;
+            $meta['continuation'] = $native;
+            $this->compareAndSwapTurn($row, $meta);
+        });
+    }
+
+    public function reconcileTurn(Continuation $turn, ?object $participant, string $previousOwner, string $evidence): Continuation
+    {
+        if (trim($evidence) === '') {
+            throw new ContinuationConflictException('Recovery requires caller-owned reconciliation evidence.');
+        }
+
+        return DB::connection($this->connection)->transaction(function () use ($turn, $participant, $previousOwner, $evidence): Continuation {
+            [$row, $meta] = $this->readContinuation($turn, $participant);
+            $native = $meta['continuation'];
+
+            if ($native['revision'] !== $turn->revision
+                || ! in_array($native['status'], ['running', 'interrupted'], true)
+                || $native['owner'] !== $previousOwner
+                || (! ($native['ordinary'] ?? false) && ($this->pausedCallIds($row) !== [] || ($native['requested_stop'] ?? false)))) {
+                throw new ContinuationConflictException('Recovery ownership, revision or saved-result disposition does not match.');
+            }
+
+            $boundary = ($native['ordinary'] ?? false) ? ($native['head_at_claim'] ?? $turn->turnId) : $turn->turnId;
+
+            if ($this->table($this->messagesTable())->where('conversation_id', $turn->conversationId)->where('id', '>', $boundary)->exists()) {
+                throw new ContinuationConflictException('A newer turn prevents recovery.');
+            }
+
+            $native['status'] = ($native['ordinary'] ?? false) ? $native['prior_status'] : 'ready';
+            $native['owner'] = null;
+            $native['revision']++;
+            $native['reconciliation'] = $evidence;
+            $meta['continuation'] = $native;
+            $this->compareAndSwapTurn($row, $meta);
+
+            return new Continuation($turn->conversationId, $turn->turnId, $native['revision']);
+        });
+    }
+
+    public function continuationReceipt(Continuation $turn, ?object $participant): array
+    {
+        [, $meta] = $this->readContinuation($turn, $participant);
+        $native = $meta['continuation'];
+
+        if (! isset($native['receipt']) || ($native['receipt_revision'] ?? null) !== $turn->revision) {
+            throw new ContinuationConflictException('No completed receipt exists for this execution revision.');
+        }
+
+        return $native['receipt'];
+    }
+
+    /** Inspect only after participant authorization; this does not authorize replay. */
+    public function continuationState(Continuation $turn, ?object $participant): array
+    {
+        return $this->readContinuation($turn, $participant)[1]['continuation'];
+    }
+
+    protected function readContinuation(Continuation $turn, ?object $participant): array
+    {
+        $this->assertContinuationOwner($turn->conversationId, $participant);
+
+        $row = $this->table($this->messagesTable())
+            ->where('conversation_id', $turn->conversationId)
+            ->where('id', $turn->turnId)
+            ->first();
+
+        if ($row === null) {
+            throw new ContinuationConflictException('The requested continuation turn does not exist.');
+        }
+
+        $meta = $this->decoded($row->meta);
+
+        if (($meta['continuation']['version'] ?? null) !== 1) {
+            throw new ContinuationConflictException('The turn does not support native continuation.');
+        }
+
+        return [$row, $meta];
+    }
+
+    protected function assertContinuationOwner(string $conversationId, ?object $participant): void
+    {
+        if (! $this->conversationBelongsTo(
+            $conversationId,
+            $participant === null ? null : Conversation::participantType($participant),
+            $participant === null ? null : Conversation::participantKey($participant),
+        )) {
+            throw new ContinuationConflictException('The participant does not own this conversation.');
+        }
+    }
+
+    /**
+     * Read conversation state through the public contract while retaining the
+     * pre-contract trait convention for existing agents.
+     */
+    protected function currentConversationFor(object $agent): ?string
+    {
+        $conversationId = $agent instanceof RemembersConversations
+            ? $agent->currentConversation()
+            : call_user_func([$agent, 'currentConversation']);
+
+        if ($conversationId !== null && ! is_string($conversationId)) {
+            throw new ContinuationConflictException('Agent returned an invalid conversation identifier.');
+        }
+
+        return $conversationId;
+    }
+
+    /**
+     * Read the participant through the public contract while retaining the
+     * pre-contract trait convention for existing agents.
+     */
+    protected function conversationParticipantFor(object $agent): ?object
+    {
+        $participant = $agent instanceof RemembersConversations
+            ? $agent->conversationParticipant()
+            : call_user_func([$agent, 'conversationParticipant']);
+
+        if ($participant !== null && ! is_object($participant)) {
+            throw new ContinuationConflictException('Agent returned an invalid conversation participant.');
+        }
+
+        return $participant;
+    }
+
+    public function advanceTurn(array $claim): void
+    {
+        DB::connection($this->connection)->transaction(function () use ($claim): void {
+            [$row, $meta] = $this->ownedTurn($claim);
+            $meta['continuation']['generation_attempts'] = ($meta['continuation']['generation_attempts'] ?? 0) + 1;
+            $this->compareAndSwapTurn($row, $meta);
+        });
+    }
+
+    public function assertTurnOwner(array $claim): void
+    {
+        $this->ownedTurn($claim);
+    }
+
+    protected function ownedTurn(array $claim): array
+    {
+        $row = $this->table($this->messagesTable())
+            ->where('conversation_id', $claim['conversation'])
+            ->where('id', $claim['turn'])
+            ->first();
+
+        if ($row === null) {
+            throw new ContinuationConflictException('The native execution turn no longer exists.');
+        }
+
+        $meta = $this->decoded($row->meta);
+
+        if (($meta['continuation']['owner'] ?? null) !== $claim['owner']
+            || ($meta['continuation']['status'] ?? null) !== 'running') {
+            throw new ContinuationConflictException('The native execution no longer owns this turn.');
+        }
+
+        return [$row, $meta];
+    }
+
+    /** All database-store writers check under the same short transaction as their write. */
+    protected function assertWriteAllowed(string $conversationId, ?string $owner): void
+    {
+        $rows = $this->assistantRows($conversationId)->lockForUpdate()->get();
+
+        if ($owner !== null && ! $rows->contains(function (object $row) use ($owner): bool {
+            $native = $this->decoded($row->meta)['continuation'] ?? null;
+
+            return ($native['status'] ?? null) === 'running' && ($native['owner'] ?? null) === $owner;
+        })) {
+            throw new ContinuationConflictException('The writer no longer owns a running turn.');
+        }
+
+        foreach ($rows as $row) {
+            $native = $this->decoded($row->meta)['continuation'] ?? null;
+
+            if (($native['status'] ?? null) === 'running' && ($native['owner'] ?? null) !== $owner) {
+                throw new ContinuationConflictException('A competing writer cannot persist over an active native turn.');
+            }
+        }
+    }
+
+    protected function hasReplayBlocks(object $row): bool
+    {
+        return $this->decodedSteps($row)->contains(fn (array $step): bool => filled($step['replay_blocks']));
+    }
+
+    protected function compareAndSwapTurn(object $row, array $meta): void
+    {
+        if ($this->table($this->messagesTable())
+            ->where('id', $row->id)
+            ->where('meta', $row->meta)
+            ->update(['meta' => json_encode($meta, JSON_THROW_ON_ERROR), 'updated_at' => now()]) !== 1) {
+            throw new ContinuationConflictException('The turn changed concurrently.');
+        }
+    }
+}
