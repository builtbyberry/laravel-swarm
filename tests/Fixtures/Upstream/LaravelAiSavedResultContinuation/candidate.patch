+<?php
+
+use Illuminate\Support\Facades\DB;
+use Laravel\Ai\Ai;
+use Laravel\Ai\Continuations\Continuation;
+use Laravel\Ai\Contracts\ConversationStore;
+use Laravel\Ai\Prompts\AgentPrompt;
+
+define('PROBE_BOOT_ONLY', true);
+require __DIR__.'/reproduce.php';
+$store = resolve(ConversationStore::class);
+$row = DB::table('agent_conversation_messages')->where('role', 'assistant')->first();
+$state = json_decode($row->meta, true)['continuation'];
+$token = new Continuation($row->conversation_id, $row->id, $state['revision']);
+$agent = (new ProbeAgent)->continue($row->conversation_id, (object) ['id' => 1]);
+$provider = Ai::textProviderFor($agent, 'anthropic');
+$prompt = new AgentPrompt($agent, '', [], $provider, $provider->defaultTextModel(), continuation: $token);
+echo "ready\n";
+flush();
+$until = microtime(true) + 10;
+while (! file_exists($argv[1]) && microtime(true) < $until) {
+    usleep(1000);
+    clearstatcache();
+}
+try {
+    $claim = $store->claimTurn($prompt);
+    echo json_encode(['claimed' => true, 'owner' => $claim['owner'], 'pid' => getmypid()])."\n";
+} catch (Throwable $e) {
+    echo json_encode(['claimed' => false, 'error' => $e::class, 'pid' => getmypid()])."\n";
+}
