+<?php
+
+namespace Laravel\Ai\Contracts;
+
+use Closure;
+use Laravel\Ai\Continuations\Continuation;
+use Laravel\Ai\Messages\UserMessage;
+use Laravel\Ai\Prompts\AgentPrompt;
+use Laravel\Ai\Responses\AgentResponse;
+use Throwable;
+
+interface ContinuesConversations extends ConversationStore
+{
+    public function storeContinuationUserMessage(string $conversationId, ?string $participantType, string|int|null $participantId, string $agent, UserMessage $message, ?string $continuationOwner): string;
+
+    public function storeContinuationAssistantMessage(string $conversationId, ?string $participantType, string|int|null $participantId, AgentPrompt $prompt, AgentResponse $response, ?Throwable $exception, ?string $continuationOwner): ?string;
+
+    public function storeContinuationApprovalResults(string $conversationId, array $toolResults, ?string $continuationOwner): void;
+
+    /** @return array<string, mixed>|null */
+    public function claimTurn(AgentPrompt $prompt): ?array;
+
+    /** Persist the response and its native receipt atomically, without remote I/O. */
+    public function finishTurn(array $claim, AgentResponse $response, Closure $persist): void;
+
+    public function interruptTurn(array $claim): void;
+
+    public function assertTurnOwner(array $claim): void;
+
+    public function advanceTurn(array $claim): void;
+
+    public function continuationState(Continuation $turn, ?object $participant): array;
+
+    /** Caller attests recovery safety after reconciling all effects and fencing the previous owner. */
+    public function reconcileTurn(Continuation $turn, ?object $participant, string $previousOwner, string $evidence): Continuation;
+
+    /** Read a native completion receipt without executing the agent or application callbacks. */
+    public function continuationReceipt(Continuation $turn, ?object $participant): array;
+}
