+<?php
+
+require __DIR__.'/../vendor/autoload.php';
+
+use Illuminate\Http\Client\Factory;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Schema;
+use Laravel\Ai\Approvals\Decisions;
+use Laravel\Ai\Continuations\Continuation;
+use Laravel\Ai\Contracts\ConversationStore;
+use Laravel\Ai\Tools\Request;
+use Tests\Fixtures\Agents\RememberingApprovableAgent;
+use Tests\Fixtures\Tools\ApprovableNumberGenerator;
+use Tests\TestCase;
+
+final class ProbeApplication extends TestCase
+{
+    public function boot(): void
+    {
+        $this->setUp();
+    }
+
+    protected function defineDatabaseMigrations(): void {}
+
+    protected function defineEnvironment($app): void
+    {
+        $app['config']->set('database.default', 'sqlite');
+        $app['config']->set('database.connections.sqlite.database', getenv('PROBE_DATABASE'));
+        $app['config']->set('ai.conversations.generate_title', false);
+        $app['config']->set('ai.providers.anthropic.key', 'local-http-fake');
+    }
+}
+final class DurableCounter extends ApprovableNumberGenerator
+{
+    public function handle(Request $request): string
+    {
+        DB::table('probe_effects')->insert(['operation' => 'approved-number']);
+
+        return '72019';
+    }
+}
+final class ProbeAgent extends RememberingApprovableAgent
+{
+    public function maxSteps(): int
+    {
+        return 5;
+    }
+
+    public function tools(): iterable
+    {
+        return [new DurableCounter];
+    }
+}
+$app = new ProbeApplication('prototype');
+$app->boot();
+Http::preventStrayRequests();
+if (defined('PROBE_BOOT_ONLY')) {
+    return;
+}
+$phase = $argv[1] ?? 'inspect';
+$success = ['id' => 'msg_final', 'type' => 'message', 'role' => 'assistant', 'model' => 'claude-sonnet-4-6', 'content' => [['type' => 'text', 'text' => 'The number is 72019.']], 'stop_reason' => 'end_turn', 'usage' => ['input_tokens' => 10, 'output_tokens' => 5]];
+$user = (object) ['id' => 1];
+$error = null;
+if ($phase === 'seed' || $phase === 'pause') {
+    foreach (glob(__DIR__.'/../database/migrations/*.php') as $file) {
+        (require $file)->up();
+    }
+    Schema::create('probe_effects', fn ($table) => $table->string('operation'));
+    Http::fake(['api.anthropic.com/*' => Http::sequence()->push(['id' => 'msg_tool', 'type' => 'message', 'role' => 'assistant', 'model' => 'claude-sonnet-4-6', 'content' => [['type' => 'tool_use', 'id' => 'toolu_1', 'name' => 'DurableCounter', 'input' => (object) []]], 'stop_reason' => 'tool_use', 'usage' => ['input_tokens' => 10, 'output_tokens' => 5]])->push(status: 500)]);
+    $paused = (new ProbeAgent)->forUser($user)->prompt('Generate a number', provider: 'anthropic');
+    if ($phase === 'seed') {
+        try {
+            (new ProbeAgent)->continue($paused->conversationId, $user)->prompt(Decisions::from(['toolu_1' => true]), provider: 'anthropic');
+        } catch (Throwable $e) {
+            $error = $e::class;
+        }
+    }
+} else {
+    Http::fake(['api.anthropic.com/*' => Http::response($success)]);
+    $conversation = DB::table('agent_conversations')->value('id');
+    if ($phase === 'prepare') {
+        $store = resolve(ConversationStore::class);
+        $id = DB::table('agent_conversation_messages')->where('role', 'assistant')->value('id');
+        $token = new Continuation($conversation, $id, 0);
+        $state = $store->continuationState($token, $user);
+        $store->reconcileTurn(new Continuation($conversation, $id, $state['revision']), $user, $state['owner'], 'Controlled fixture: previous process exited and effects reconciled.');
+    }
+    if ($phase === 'receipt') {
+        $store = resolve(ConversationStore::class);
+        $row = DB::table('agent_conversation_messages')->where('role', 'assistant')->first();
+        $native = json_decode($row->meta, true)['continuation'];
+        $receipt = $store->continuationReceipt(new Continuation($conversation, $row->id, $native['receipt_revision']), $user);
+    }
+    if ($phase === 'kill-resume') {
+        $barrier = getenv('PROBE_BARRIER');
+        Http::swap(new Factory);
+        Http::preventStrayRequests();
+        Http::fake(['api.anthropic.com/*' => function () use ($barrier) {
+            touch($barrier);
+            echo "provider-barrier\n";
+            flush();
+
+            while (true) {
+                usleep(100_000);
+            }
+        }]);
+        (new ProbeAgent)->continue($conversation, $user)->prompt(Decisions::from(['toolu_1' => true]), provider: 'anthropic');
+    }
+    if ($phase === 'retry-decisions' || $phase === 'blank' || $phase === 'continuation' || $phase === 'recover') {
+        try {
+            $input = match ($phase) {
+                'retry-decisions' => Decisions::from(['toolu_1' => true]),
+                'blank' => '',
+                'continuation', 'recover' => new Continuation($conversation, DB::table('agent_conversation_messages')->where('role', 'assistant')->value('id'), 1),
+            };
+            if ($phase === 'continuation' || $phase === 'recover') {
+                $store = resolve(ConversationStore::class);
+                $state = $store->continuationState($input, $user);
+                if (DB::table('probe_effects')->count() !== 1) {
+                    throw new RuntimeException('Fixture reconciliation failed');
+                }
+                $input = $store->reconcileTurn(new Continuation($conversation, $input->turnId, $state['revision']), $user, $state['owner'], 'Controlled fixture: old process exited; only approved local DB effect exists; subsequent HTTP 500 had no later tools or hooks.');
+            }
+            $result = (new ProbeAgent)->continue($conversation, $user)->prompt($input, provider: 'anthropic');
+        } catch (Throwable $e) {
+            $error = $e::class.': '.$e->getMessage();
+        }
+    }
+}
+$rows = DB::table('agent_conversation_messages')->orderBy('id')->get();
+$report = ['phase' => $phase, 'pid' => getmypid(), 'error' => $error, 'result' => $result->text ?? null, 'receipt' => $receipt ?? null, 'effects' => DB::table('probe_effects')->count(), 'users' => $rows->where('role', 'user')->count(), 'rows' => $rows->map(fn ($r) => ['id' => $r->id, 'role' => $r->role, 'content' => $r->content, 'steps' => json_decode($r->steps, true), 'meta' => json_decode($r->meta, true), 'status' => $r->status])->all(), 'http_requests' => Http::recorded()->count()];
+echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES).PHP_EOL;
+if (($phase === 'continuation' || $phase === 'recover') && ($report['result'] !== 'The number is 72019.' || $report['effects'] !== 1 || $report['users'] !== 1)) {
+    exit(1);
+}
