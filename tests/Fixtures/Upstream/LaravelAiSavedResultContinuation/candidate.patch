+test('SIGKILL after a durable tool result resumes the same native turn in a fresh process', function () {
+    $path = tempnam(sys_get_temp_dir(), 'ai-kill-');
+    $barrier = $path.'.provider';
+
+    try {
+        (new Process([PHP_BINARY, __DIR__.'/../../prototype/reproduce.php', 'pause'], env: [
+            'PROBE_DATABASE' => $path,
+        ]))->mustRun();
+
+        $worker = new Process([PHP_BINARY, __DIR__.'/../../prototype/reproduce.php', 'kill-resume'], env: [
+            'PROBE_DATABASE' => $path,
+            'PROBE_BARRIER' => $barrier,
+        ]);
+        $worker->start();
+        $worker->waitUntil(fn (string $type, string $buffer): bool => str_contains($buffer, 'provider-barrier'));
+
+        $inspect = new Process([PHP_BINARY, __DIR__.'/../../prototype/reproduce.php', 'inspect'], env: [
+            'PROBE_DATABASE' => $path,
+        ]);
+        $inspect->mustRun();
+        $beforeKill = json_decode($inspect->getOutput(), true, flags: JSON_THROW_ON_ERROR);
+
+        expect($beforeKill['effects'])->toBe(1)
+            ->and($beforeKill['users'])->toBe(1)
+            ->and($beforeKill['rows'][1]['steps'][0]['tool_calls'][0]['result'])->toBe('72019')
+            ->and($beforeKill['rows'][1]['meta']['continuation']['status'])->toBe('running');
+
+        $worker->signal(SIGKILL);
+        $worker->wait();
+
+        expect($worker->getTermSignal())->toBe(SIGKILL);
+
+        $recovery = new Process([PHP_BINARY, __DIR__.'/../../prototype/reproduce.php', 'recover'], env: [
+            'PROBE_DATABASE' => $path,
+        ]);
+        $recovery->mustRun();
+        $result = json_decode($recovery->getOutput(), true, flags: JSON_THROW_ON_ERROR);
+
+        expect($result['result'])->toBe('The number is 72019.')
+            ->and($result['effects'])->toBe(1)
+            ->and($result['users'])->toBe(1)
+            ->and($result['http_requests'])->toBe(1)
+            ->and($result['rows'])->toHaveCount(2)
+            ->and($result['rows'][1]['meta']['continuation']['status'])->toBe('completed');
+    } finally {
+        if (isset($worker) && $worker->isRunning()) {
+            $worker->signal(SIGKILL);
+            $worker->wait();
+        }
+
+        if (file_exists($path)) {
+            unlink($path);
+        }
+
+        if (file_exists($barrier)) {
+            unlink($barrier);
+        }
+    }
+});
