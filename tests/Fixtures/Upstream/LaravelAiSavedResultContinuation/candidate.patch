+test('two fresh PHP processes compete for one conditional native claim', function () {
+    $path = tempnam(sys_get_temp_dir(), 'ai-race-');
+    $barrier = $path.'.go';
+    try {
+        foreach (['seed', 'prepare'] as $phase) {
+            (new Process([PHP_BINARY, __DIR__.'/../../prototype/reproduce.php', $phase], env: ['PROBE_DATABASE' => $path]))->mustRun();
+        }
+        $workers = [];
+        for ($i = 0; $i < 2; $i++) {
+            $p = new Process([PHP_BINARY, __DIR__.'/../../prototype/compete.php', $barrier], env: ['PROBE_DATABASE' => $path]);
+            $p->start();
+            $workers[] = $p;
+        }
+        foreach ($workers as $worker) {
+            $worker->waitUntil(fn ($type, $buffer) => str_contains($buffer, 'ready'));
+        }
+        touch($barrier);
+        $results = [];
+        foreach ($workers as $worker) {
+            $worker->wait();
+            $lines = explode("\n", trim($worker->getOutput()));
+            $results[] = json_decode(end($lines), true, flags: JSON_THROW_ON_ERROR);
+        }
+        expect(array_column($results, 'claimed'))->toContain(true, false)->and(array_unique(array_column($results, 'pid')))->toHaveCount(2);
+    } finally {
+        foreach ($workers ?? [] as $worker) {
+            if ($worker->isRunning()) {
+                $worker->stop();
+            }
+        }unlink($path);
+        if (file_exists($barrier)) {
+            unlink($barrier);
+        }
+    }
+});
