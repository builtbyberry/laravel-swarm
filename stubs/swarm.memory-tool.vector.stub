<?php

declare(strict_types=1);

namespace {{ namespace }};

use Laravel\Ai\Contracts\Agent;
use BuiltByBerry\LaravelSwarm\Enums\MemoryScope;
use BuiltByBerry\LaravelSwarm\Tools\Recall;
use Laravel\Ai\Tools\Request;
use Stringable;

/**
 * {{ class }} — generated by `php artisan make:memory-tool --vector`.
 *
 * A vector-aware memory tool built on the shipped `Recall` tool and the
 * `builtbyberry/laravel-swarm-memory-vector` companion package. Instead of the
 * exact key/prefix lookups the base `Recall` does, this tool answers a free-text
 * `query` by semantic similarity against the run's accumulated memory, then
 * falls back to the base tool's deterministic reads when no query is given.
 *
 * The scope id is always resolved from the active swarm run, never from the
 * model, so the tool can only ever search the current run's, conversation's,
 * agent's, or swarm's memory. Reads still flow through the active swarm's
 * propagation policy, so a vector hit can never surface an entry the policy
 * withholds from this agent.
 *
 * This subclass defaults to the `{{ scopeCase }}` scope. Override the protected
 * hooks below to specialise it.
 *
 * See: docs/generators.md, docs/memory.md#recall-and-remember-tools,
 * https://github.com/builtbyberry/laravel-swarm-memory-vector
 */
class {{ class }} extends Recall
{
    /**
     * The default memory scope this tool searches when the model omits one.
     */
    protected MemoryScope $defaultScope = MemoryScope::{{ scopeCase }};

    /**
     * The name the model calls this tool by.
     */
    public function name(): string
    {
        return '{{ toolName }}';
    }

    /**
     * Describe the tool for the model. Make the semantic-search behaviour
     * explicit so the model prefers a natural-language `query`.
     */
    public function description(): Stringable|string
    {
        return <<<'TEXT'
        Search this run's shared memory by meaning. Pass a natural-language
        `query` to retrieve the most relevant entries by semantic similarity,
        or a `key`/`prefix` for an exact lookup. Only memory the active
        visibility policy permits this agent to see is returned.
        TEXT;
    }

    /**
     * Execute the tool. A `query` runs a vector search; otherwise we defer to
     * the base `Recall` for exact key/prefix/scope reads.
     */
    public function handle(Request $request): string
    {
        $query = trim($request->string('query')->toString());

        if ($query === '') {
            return parent::handle($request);
        }

        $scope = $this->resolveScope($request->string('scope')->toString());

        if ($scope === null) {
            return 'Unknown memory scope. Use one of: run, swarm, agent, conversation.';
        }

        return $this->semanticRecall($query, $scope);
    }

    /**
     * Run the semantic search against the companion vector store.
     *
     * TODO: wire this to the `builtbyberry/laravel-swarm-memory-vector`
     * companion. Resolve its vector recall service from the container and run
     * the query against the resolved scope, e.g.:
     *
     *   $reader = Container::getInstance()->make(
     *       \BuiltByBerry\LaravelSwarmMemoryVector\Contracts\VectorMemoryReader::class
     *   );
     *
     *   return $reader->search($scope, $query, limit: 5);
     *
     * Consult the companion package's README for its exact public surface.
     */
    protected function semanticRecall(string $query, MemoryScope $scope): string
    {
        // Placeholder until the companion reader is wired (see TODO above).
        return 'Vector recall is not configured yet. Wire the '
            .'laravel-swarm-memory-vector companion in '.static::class.'::semanticRecall().';
    }

    /**
     * Resolve the requested scope name, defaulting to this tool's scope.
     */
    protected function resolveScope(string $scope): ?MemoryScope
    {
        $scope = trim($scope);

        if ($scope === '') {
            return $this->defaultScope;
        }

        return MemoryScope::tryFrom($scope);
    }

    /**
     * The agent this tool acts as. Return a concrete agent to make the `agent`
     * scope addressable; leave null for a scope-driven tool.
     */
    protected function agent(): ?Agent
    {
        return null;
    }
}
