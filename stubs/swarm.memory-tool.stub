<?php

declare(strict_types=1);

namespace {{ namespace }};

use BuiltByBerry\LaravelSwarm\Enums\MemoryScope;
use BuiltByBerry\LaravelSwarm\Tools\{{ baseTool }};

/**
 * {{ class }} — generated by `php artisan make:memory-tool`.
 *
 * A custom memory tool built on the shipped `{{ baseTool }}` tool. Drop it into
 * any `laravel/ai` agent's `tools()` array (or expose it via the
 * `HasSwarmMemoryTools` trait). The scope id is always resolved from the active
 * swarm run, never from the model, so the tool can only address the current
 * run's, conversation's, agent's, or swarm's memory.
 *
 * This subclass defaults the tool to the `{{ scopeCase }}` scope. Override the
 * protected hooks below to specialise it, for example tenant-scope a read or
 * add validation to a write. To make the `agent` scope addressable, return
 * `(new {{ class }})->forAgent($this)` from the agent's `tools()` method. The
 * `HasSwarmMemoryTools` trait binds the stock tools the same way when an agent
 * calls `swarmMemoryTools(agentScope: true)` and
 * `swarm.memory.tools.agent_scope` is enabled.
 *
 * See: docs/generators.md, docs/memory.md#recall-and-remember-tools
 */
class {{ class }} extends {{ baseTool }}
{
    /**
     * The default memory scope this tool reads or writes when the model omits
     * one. Generated as `{{ scopeCase }}`; change it to retarget the tool.
     */
    protected MemoryScope $defaultScope = MemoryScope::{{ scopeCase }};

    /**
     * The name the model calls this tool by. Must be unique within an agent's
     * tool set.
     */
    public function name(): string
    {
        return '{{ toolName }}';
    }

    /**
     * Resolve the requested scope name to a {@see MemoryScope}, defaulting to
     * this tool's configured scope when the model omits it. Returns null for an
     * unknown name (the base tool reports that to the model).
     */
    protected function resolveScope(string $scope): ?MemoryScope
    {
        $scope = trim($scope);

        if ($scope === '') {
            return $this->defaultScope;
        }

        return MemoryScope::tryFrom($scope);
    }
}
