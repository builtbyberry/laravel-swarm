/**
 * {{ class }} — generated by `php artisan make:swarm:swarm --topology=parallel`.
 *
 * Parallel topology: every agent receives the *original* task input. Laravel
 * Concurrency runs them in worker callbacks, then the runner merges the
 * results back into a single SwarmResponse with one step per agent in
 * declaration order.
 *
 * Container contract: parallel agents must be resolvable by class name.
 * Plain concrete classes work out of the box. If an agent depends on an
 * interface, bind it in a service provider.
 *
 * Next step: docs/parallel.md, docs/examples.md
 */
#[Topology(TopologyEnum::Parallel)]
class {{ class }} implements Swarm
{
    use Runnable;

    /**
     * @return array<int, \BuiltByBerry\LaravelSwarm\Contracts\Agent>
     */
    public function agents(): array
    {
        return [
            // new \App\Ai\Agents\YourFirstScout,
            // new \App\Ai\Agents\YourSecondScout,
        ];
    }
}
