{
    "name": "builtbyberry/laravel-swarm",
    "description": "Multi-agent swarm orchestration for Laravel, built on Laravel AI.",
    "keywords": ["laravel", "ai", "agents", "swarm", "orchestration"],
    "homepage": "https://swarm.builtbyberry.com",
    "support": {
        "docs": "https://swarm.builtbyberry.com",
        "issues": "https://github.com/builtbyberry/laravel-swarm/issues",
        "source": "https://github.com/builtbyberry/laravel-swarm"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Berry",
            "email": "daniel@jstreetdigital.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/concurrency": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "laravel/ai": "^0.8"
    },
    "require-dev": {
        "builtbyberry/laravel-swarm-installer-testkit": "^0.1.0",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "conflict": {
        "guzzlehttp/guzzle": "<7.12.1"
    },
    "autoload": {
        "psr-4": {
            "BuiltByBerry\\LaravelSwarm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BuiltByBerry\\LaravelSwarm\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.19.x-dev"
        },
        "laravel": {
            "providers": [
                "BuiltByBerry\\LaravelSwarm\\SwarmServiceProvider"
            ],
            "aliases": {
                "Swarm": "BuiltByBerry\\LaravelSwarm\\Facades\\Swarm",
                "SwarmHistory": "BuiltByBerry\\LaravelSwarm\\Facades\\SwarmHistory"
            }
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G --no-progress",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "test": "vendor/bin/pest tests/Feature tests/Unit tests/Installer",
        "test:process-concurrency": "vendor/bin/pest tests/ProcessConcurrency",
        "test:process-concurrency:ci": "vendor/bin/pest tests/ProcessConcurrency --fail-on-skipped --exclude-group=skip-locked-real-db",
        "test:process-concurrency:real-db": "vendor/bin/pest tests/ProcessConcurrency --group=skip-locked-real-db --fail-on-skipped",
        "test:coverage": "vendor/bin/pest tests/Feature tests/Unit tests/Installer --coverage",
        "test:coverage:ci": "vendor/bin/pest tests/Feature tests/Unit tests/Installer --coverage --min=80",
        "test:compliance": "vendor/bin/pest tests/Feature tests/Unit --group=compliance --fail-on-skipped",
        "test:mutation": "vendor/bin/pest --mutate --coverage --parallel --covered-only",
        "hooks:install": "ln -sfv ../../tools/git-hooks/commit-msg .git/hooks/commit-msg"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
